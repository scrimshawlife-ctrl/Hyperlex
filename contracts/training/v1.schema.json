{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Proposed SHADOW contracts. Provenance: Notion Sprint 001 Hub NOT_COMPUTABLE + Loop 805 Slice N/A + Hash: b3eee725054c1ed1dae16fad3464af005edad0cc (base)",
  "$defs": {
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]*$","maxLength":160},
    "text": {"type":"string","pattern":"\\S"},
    "hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source": {
      "type":"object","additionalProperties":false,
      "required":["version","source_id","raw_text","text_sha256","source_kind","rights_status","rights_reference","provenance_reference"],
      "properties": {
        "version":{"const":"source.v1"},"source_id":{"$ref":"#/$defs/id"},
        "raw_text":{"$ref":"#/$defs/text"},"text_sha256":{"$ref":"#/$defs/hash"},
        "source_kind":{"enum":["term","context","definition","citation","markup","synthetic"]},
        "rights_status":{"enum":["approved","unreviewed","restricted"]},
        "rights_reference":{"$ref":"#/$defs/text"},"provenance_reference":{"$ref":"#/$defs/text"}
      }
    },
    "label": {
      "type":"object","additionalProperties":false,
      "required":["status","values","loss_mask","method","reviewer"],
      "properties": {
        "status":{"enum":["unreviewed","weak","reviewed","disputed"]},
        "values":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},
        "loss_mask":{"type":"boolean"},"method":{"$ref":"#/$defs/text"},
        "reviewer":{"type":["string","null"]}
      }
    },
    "span": {
      "type":"object","additionalProperties":false,"required":["occurrence_id","start","end","text","role"],
      "properties": {
        "occurrence_id":{"$ref":"#/$defs/id"},"start":{"type":"integer","minimum":0},
        "end":{"type":"integer","minimum":1},"text":{"$ref":"#/$defs/text"},"role":{"$ref":"#/$defs/text"}
      }
    },
    "annotation": {
      "type":"object","additionalProperties":false,
      "required":["version","example_id","source_id","group_ids","offset_unit","spans","labels","ontology_version"],
      "properties": {
        "version":{"const":"annotation.v1"},"example_id":{"$ref":"#/$defs/id"},"source_id":{"$ref":"#/$defs/id"},
        "group_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "offset_unit":{"const":"unicode_codepoint"},"ontology_version":{"$ref":"#/$defs/id"},
        "spans":{"type":"array","items":{"$ref":"#/$defs/span"}},
        "labels":{"type":"object","minProperties":1,"additionalProperties":false,
          "properties":{"family":{"$ref":"#/$defs/label"},"typology":{"$ref":"#/$defs/label"},"stage":{"$ref":"#/$defs/label"},"structure":{"$ref":"#/$defs/label"}}}
      }
    },
    "split": {
      "type":"object","additionalProperties":false,"required":["version","split_id","assignments"],
      "properties": {
        "version":{"const":"split.v1"},"split_id":{"$ref":"#/$defs/id"},
        "assignments":{"type":"array","minItems":1,"items":{
          "type":"object","additionalProperties":false,"required":["example_id","partition"],
          "properties":{"example_id":{"$ref":"#/$defs/id"},"partition":{"enum":["train","dev","test"]}}
        }}
      }
    },
    "run": {
      "type":"object","additionalProperties":false,
      "required":["version","run_id","code_commit","code_patch_sha256","source_sha256","annotation_sha256","split_sha256","checkpoint_sha256","trunk_revision","tokenizer_revision","seed","environment","recipe","name_gate","brier"],
      "properties": {
        "version":{"const":"run.v1"},"run_id":{"$ref":"#/$defs/id"},
        "code_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "code_patch_sha256":{"$ref":"#/$defs/hash"},"source_sha256":{"$ref":"#/$defs/hash"},
        "annotation_sha256":{"$ref":"#/$defs/hash"},"split_sha256":{"$ref":"#/$defs/hash"},
        "checkpoint_sha256":{"$ref":"#/$defs/hash"},"trunk_revision":{"$ref":"#/$defs/text"},
        "tokenizer_revision":{"$ref":"#/$defs/text"},"seed":{"type":"integer","minimum":0},
        "environment":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/text"}},
        "recipe":{"type":"object","additionalProperties":false,"required":["sampler","optimizer","learning_rate","batch_size","epochs"],
          "properties":{"sampler":{"$ref":"#/$defs/text"},"optimizer":{"$ref":"#/$defs/text"},
            "learning_rate":{"type":"number","exclusiveMinimum":0},"batch_size":{"type":"integer","minimum":1},"epochs":{"type":"integer","minimum":1}}},
        "name_gate":{"const":false},"brier":{"type":"null"}
      }
    },
    "evaluation": {
      "type":"object","additionalProperties":false,
      "required":["version","protocol_id","run_id","population","example_ids","task","decoder_access","n_evaluated","n_exact","exact","name_gate","brier"],
      "properties": {
        "version":{"const":"evaluation.v1"},"protocol_id":{"$ref":"#/$defs/id"},"run_id":{"$ref":"#/$defs/id"},
        "population":{"enum":["residual_only","dev","test"]},
        "example_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "task":{"enum":["surface_extraction","bound_recovery","oracle_span_diagnostic"]},
        "decoder_access":{"enum":["text","representation_only","gold_spans"]},
        "n_evaluated":{"type":"integer","minimum":1},"n_exact":{"type":"integer","minimum":0},
        "exact":{"type":"number","minimum":0,"maximum":1},"name_gate":{"const":false},"brier":{"type":"null"}
      }
    },
    "bundle": {
      "type":"object","additionalProperties":false,"required":["sources","annotations","split","run","evaluation"],
      "properties":{
        "sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
        "annotations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/annotation"}},
        "split":{"$ref":"#/$defs/split"},"run":{"$ref":"#/$defs/run"},"evaluation":{"$ref":"#/$defs/evaluation"}
      }
    }
  },
  "$ref":"#/$defs/bundle"
}
