{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scrimshawlife-ctrl/Hyperlex-Hermes-Specs/schemas/result.v1.schema.json",
  "title": "Hyperlex Memetic Result v1",
  "type": "object",
  "required": [
    "observed",
    "inferred",
    "speculative",
    "provenance",
    "analysis"
  ],
  "properties": {
    "observed": {
      "type": "string"
    },
    "inferred": {
      "type": "string"
    },
    "speculative": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "canonical_hash",
        "timestamp",
        "version",
        "brier",
        "hyperstition_risk",
        "ingest_source"
      ],
      "properties": {
        "canonical_hash": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "brier": {
          "type": "number"
        },
        "hyperstition_risk": {
          "type": "string"
        },
        "memclaw": {
          "type": "string"
        },
        "arxiv_concepts_applied": {
          "type": "array"
        },
        "ingest_source": {
          "type": "string"
        },
        "episodic_consolidation": {
          "type": "boolean"
        },
        "context_chain": {
          "type": "array"
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "neologisms": {
          "type": "array"
        },
        "semantic_variation": {
          "type": "object"
        },
        "virality": {
          "type": "object"
        },
        "memetics": {
          "type": "object"
        },
        "hyperstition": {
          "type": "object"
        },
        "memory_tiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "context_friction": {
          "type": "object"
        },
        "compression": {
          "type": "object"
        },
        "memetic_memory": {
          "type": "object"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    }
  },
  "additionalProperties": true
}