{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scrimshawlife-ctrl/Hyperlex-Hermes-Specs/schemas/result.v1.schema.json",
  "title": "Hyperlex Memetic Result v1",
  "type": "object",
    "required": ["observed", "inferred", "speculative", "provenance", "analysis"],
    "properties": {
    "observed": { "type": "string" },
    "inferred": { "type": "string" },
    "speculative": { "type": "string" },
        "provenance": {
          "type": "object",
      "required": ["canonical_hash", "timestamp", "version", "brier", "hyperstition_risk", "ingest_source"],
          "properties": {
        "canonical_hash": { "type": "string" },
        "timestamp": { "type": "string" },
        "version": { "type": "string" },
        "brier": {
          "type": ["number", "null"],
          "description": "Always null on open analysis. Numeric Brier only after settlement (see hyperlex.calibration)."
        },
        "brier_note": { "type": "string" },
        "hyperstition_risk": { "type": "string" },
        "memclaw": { "type": "string" },
        "arxiv_concepts_applied": { "type": "array" },
            "ingest_source": { "type": "string" }
          },
          "additionalProperties": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "evidence_id": { "type": "string" },
              "requested_source": { "type": "string" },
              "effective_source": { "type": "string" },
              "acquisition_status": { "type": "string" },
              "evidence_class": { "type": "string" },
              "failure_reason": { "type": ["string", "null"] },
              "eligible_for_observed": { "type": "boolean" },
              "fetched_at": { "type": "string" },
              "cached": { "type": "boolean" },
              "content_hash": { "type": "string" },
              "status_code": { "type": ["integer", "null"] },
              "source_locator": { "type": ["string", "null"] },
              "snippet": { "type": "string" }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": { "type": "string" },
              "statement": { "type": "string" },
              "epistemic_status": { "type": "string" },
              "confidence": { "type": "number" },
              "evidence_refs": { "type": "array", "items": { "type": "string" } },
              "method": { "type": "string" },
              "counterevidence_refs": { "type": "array", "items": { "type": "string" } },
              "valid_as_of": { "type": "string" }
            }
          }
        },
        "analysis": {
      "type": "object",
      "properties": {
        "neologisms": { "type": "array" },
        "semantic_variation": { "type": "object" },
        "virality": { "type": "object" },
        "memetics": { "type": "object" },
        "hyperstition": { "type": "object" },
        "lineage": {
          "type": "object",
          "description": "Optional slang lineage match (see lineage.v1.schema.json)",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" },
    "recommendation": { "type": "string" },
    "schema_validation": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
