+        "filler_head": _cpu_module_state(filler_head),
+        "encoder": collect_encoder_trainable(encoder),
+        "maps": {k: v for k, v in maps.items() if k not in {"family_of", "role_of", "filler_of"}},
+        "layout": layout,
+    }
