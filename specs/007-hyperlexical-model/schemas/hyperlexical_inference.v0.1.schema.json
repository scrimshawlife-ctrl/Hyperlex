{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyperlex.hyperlexical.inference.v0.1",
  "title": "Hyperlex Hyperlexical inference packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "brier",
    "forecast_eligible",
    "routes_claimed",
    "class"
  ],
  "properties": {
    "schema": {
      "const": "hyperlex.hyperlexical.inference.v0.1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "param_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "surface": {
      "type": ["string", "null"]
    },
    "payload_ref": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "lineage_family": {
      "type": ["string", "null"]
    },
    "lineage_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "typology": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "stage": {
      "type": ["string", "null"],
      "enum": ["noise", "circulating", "contested", "hyperstition_ish", null]
    },
    "role_scheme": {
      "type": ["string", "null"],
      "enum": ["positional", "type_slot", null]
    },
    "unbind_ok": {
      "type": "boolean"
    },
    "unbind": {
      "type": ["object", "null"]
    },
    "routes_claimed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["form", "lexical"]
      }
    },
    "restricted_intent_suspected": {
      "type": "boolean",
      "default": false
    },
    "brier": {
      "type": "null"
    },
    "forecast_eligible": {
      "const": false
    },
    "auto_fire": {
      "const": false
    },
    "class": {
      "type": "string",
      "enum": ["OBSERVED", "INFERRED", "SPECULATIVE"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "restricted_intent_suspected": { "const": true } },
        "required": ["restricted_intent_suspected"]
      },
      "then": {
        "properties": { "surface": { "type": "null" } },
        "required": ["payload_ref"]
      }
    }
  ]
}
