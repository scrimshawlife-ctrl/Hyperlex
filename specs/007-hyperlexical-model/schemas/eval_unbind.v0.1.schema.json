{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyperlex.hyperlexical.eval_unbind.v0.1",
  "title": "Hyperlex Hyperlexical unbind eval report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "e2_pass", "brier", "forecast_eligible", "model_id", "probe_swap_min", "stub_swap"],
  "properties": {
    "schema": { "const": "hyperlex.hyperlexical.eval_unbind.v0.1" },
    "probe_schema": { "type": ["string", "null"] },
    "probe_positional_swap": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "probe_type_slot_swap": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "probe_swap_min": { "type": "number", "minimum": 0, "maximum": 1 },
    "stub_swap": { "type": "number", "minimum": 0, "maximum": 1 },
    "n_test": { "type": ["integer", "null"], "minimum": 0 },
    "e2_pass": { "type": "boolean" },
    "model_id": { "type": "string", "minLength": 1 },
    "trunk": { "type": ["string", "null"] },
    "trunk_loaded": { "type": "boolean" },
    "trunk_forward": { "type": ["boolean", "null"] },
    "trunk_dir": { "type": ["string", "null"] },
    "model_dir": { "type": ["string", "null"] },
    "heads_loaded": { "type": ["boolean", "null"] },
    "weight_file": { "type": ["string", "null"] },
    "model_swap": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "unbind_exact": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "n_unbind_eval": { "type": ["integer", "null"], "minimum": 0 },
    "unbind_token_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "unbind_token_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "unbind_token_recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "unbind_slot_f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "name_gate": { "const": false },
    "device": { "type": ["string", "null"] },
    "brier": { "type": "null" },
    "forecast_eligible": { "const": false },
    "note": { "type": ["string", "null"] }
  },
  "not": {
    "anyOf": [
      { "required": ["symbolic"] },
      { "required": ["has_symbols"] }
    ]
  }
}
