{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperlex.local/schemas/residual-threshold-direction-analysis.schema.json",
  "title": "Residual-threshold direction analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_scope",
    "confound_analysis_run",
    "direction_result",
    "direction_rule",
    "high_distribution",
    "high_larger_pairs",
    "json_schema_document",
    "json_schema_exists",
    "labels_changed",
    "mann_whitney_u",
    "mean_difference",
    "median_difference",
    "precision_wilson_run",
    "rank_biserial",
    "readiness_changed",
    "ready_high_count",
    "ready_quarantine_count",
    "ready_reject_count",
    "ready_secondary_count",
    "reject_quarantine_comparison_run",
    "residual_recomputed",
    "roc_auc",
    "rows_excluded",
    "secondary_distribution",
    "secondary_larger_pairs",
    "source_label_hash",
    "source_score_hash",
    "source_support_join_hash",
    "source_support_join_receipt_hash",
    "source_support_reassessment_hash",
    "threshold_search_run",
    "ties",
    "uncertainty"
  ],
  "properties": {
    "analysis_scope": {"const": "DIRECTION_ONLY"},
    "confound_analysis_run": {"const": false},
    "direction_result": {
      "enum": ["SUPPORTED_DIRECTION", "INVERTED_DIRECTION", "NO_DIRECTIONAL_SEPARATION"]
    },
    "direction_rule": {"type": "string", "minLength": 1},
    "high_distribution": {"$ref": "residual-threshold-common.schema.json#/$defs/distribution"},
    "high_larger_pairs": {"type": "integer", "minimum": 0},
    "json_schema_document": {"type": "null"},
    "json_schema_exists": {"const": false},
    "labels_changed": {"const": false},
    "mann_whitney_u": {"$ref": "residual-threshold-common.schema.json#/$defs/effect_decimal"},
    "mean_difference": {"$ref": "residual-threshold-common.schema.json#/$defs/residual_decimal"},
    "median_difference": {"$ref": "residual-threshold-common.schema.json#/$defs/residual_decimal"},
    "precision_wilson_run": {"const": false},
    "rank_biserial": {"$ref": "residual-threshold-common.schema.json#/$defs/effect_decimal"},
    "readiness_changed": {"const": false},
    "ready_high_count": {"type": "integer", "minimum": 0},
    "ready_quarantine_count": {"type": "integer", "minimum": 0},
    "ready_reject_count": {"type": "integer", "minimum": 0},
    "ready_secondary_count": {"type": "integer", "minimum": 0},
    "reject_quarantine_comparison_run": {"const": false},
    "residual_recomputed": {"const": false},
    "roc_auc": {"$ref": "residual-threshold-common.schema.json#/$defs/effect_decimal"},
    "rows_excluded": {"const": 0},
    "secondary_distribution": {"$ref": "residual-threshold-common.schema.json#/$defs/distribution"},
    "secondary_larger_pairs": {"type": "integer", "minimum": 0},
    "source_label_hash": {"$ref": "residual-threshold-common.schema.json#/$defs/sha256"},
    "source_score_hash": {"$ref": "residual-threshold-common.schema.json#/$defs/sha256"},
    "source_support_join_hash": {"$ref": "residual-threshold-common.schema.json#/$defs/sha256"},
    "source_support_join_receipt_hash": {"$ref": "residual-threshold-common.schema.json#/$defs/sha256"},
    "source_support_reassessment_hash": {"$ref": "residual-threshold-common.schema.json#/$defs/sha256"},
    "threshold_search_run": {"const": false},
    "ties": {"type": "integer", "minimum": 0},
    "uncertainty": {"const": "UNCERTAINTY_INTERVAL_NOT_COMPUTED"}
  }
}
