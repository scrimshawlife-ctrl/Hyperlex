{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hyperlex.classification.v5.stage_a_label_provenance.v1",
  "title": "HYPERLEX_V5_STAGE_A_LABEL_PROVENANCE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["label_provenance"],
  "properties": {
    "label_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "derivation",
        "evidence_basis",
        "reviewer_state",
        "source_labels",
        "rule_id",
        "rule_version",
        "decision_sha256"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "enum": [
            "HUMAN_SETTLED",
            "CANONICAL_RULE",
            "SOURCE_ASSERTED",
            "DERIVED_RULE"
          ]
        },
        "derivation": {
          "type": "string",
          "enum": [
            "DIRECT",
            "MAPPED",
            "PAIRWISE_CONTRAST",
            "NEGATIVE_EXCLUSION",
            "AMBIGUITY_SETTLEMENT"
          ]
        },
        "evidence_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "TEXT_SPAN",
                  "SOURCE_ASSERTION",
                  "FAMILY_REQUIRED_CORE",
                  "PAIR_CONTRAST",
                  "EXCLUSION_RULE",
                  "HUMAN_SETTLEMENT",
                  "CANONICAL_MAPPING"
                ]
              },
              "reference": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "family": { "type": "string" },
              "exclusion_reason_codes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evaluated_active_families": {
                "type": "array",
                "items": { "type": "string" }
              },
              "failed_required_cores": {
                "type": "array",
                "items": { "type": "string" }
              },
              "ambiguity_reason": {
                "type": "string",
                "enum": [
                  "INSUFFICIENT_CONTEXT",
                  "CONFLICTING_EVIDENCE",
                  "PARTIAL_REQUIRED_CORE",
                  "MULTIPLE_PLAUSIBLE_INTERPRETATIONS",
                  "UNRESOLVED_SOURCE_MEANING"
                ]
              }
            }
          }
        },
        "reviewer_state": {
          "type": "string",
          "enum": ["UNREVIEWED_RULE_DERIVED", "REVIEWED", "SETTLED"]
        },
        "source_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rule_id": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "rule_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
