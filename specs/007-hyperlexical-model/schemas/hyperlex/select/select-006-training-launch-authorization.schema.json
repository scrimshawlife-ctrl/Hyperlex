    },
    "decision_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compensation",
        "efficiency",
        "missing_required_metric",
        "noncomputable_required_metric",
        "pass_requires",
        "preservation",
        "primary_equality",
        "primary_preservation",
        "primary_strict_increase_required",
        "select_005_rule_not_reused"
      ],
      "properties": {
        "compensation": {"const": false},
        "efficiency": {"const": "candidate_optimizer_steps * 4 <= control_optimizer_steps"},
        "missing_required_metric": {"const": "FAIL"},
        "noncomputable_required_metric": {"const": "FAIL"},
        "pass_requires": {
          "const": [
            "classification_accuracy",
            "efficiency",
            "observed_label_accuracy",
            "primary_preservation",
            "unbind_clean_exact"
          ]
        },
        "preservation": {"const": "candidate >= control on each preservation metric"},
        "primary_equality": {"const": "PASS"},
        "primary_preservation": {
          "const": "candidate_classify_macro_f1_nonnone >= control_classify_macro_f1_nonnone - EPSILON"
        },
        "primary_strict_increase_required": {"const": false},
        "select_005_rule_not_reused": {"const": "primary delta > 0"}
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
