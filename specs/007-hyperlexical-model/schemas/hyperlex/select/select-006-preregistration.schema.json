{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperlex.local/schemas/hyperlex.select_006_preregistration.v1",
  "title": "SELECT-006 efficiency preservation preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_schedule",
    "control_schedule",
    "efficiency_gate",
    "epsilon",
    "epsilon_justification",
    "evaluation_reserve",
    "experiment_id",
    "hypothesis",
    "invalid_loader_exclusion",
    "question",
    "schema",
    "scientific_variable",
    "sealed",
    "training_launch_authorized",
    "training_started",
    "vocabulary_expansion"
  ],
  "properties": {
    "candidate_schedule": {"type": "object"},
    "control_schedule": {"type": "object"},
    "efficiency_gate": {"type": "object"},
    "epsilon": {"const": 0},
    "epsilon_justification": {"type": "string", "minLength": 40},
    "evaluation_reserve": {"type": "object"},
    "experiment_id": {"const": "HLX-EXP-2026-09-29-SELECT-006"},
    "hypothesis": {"type": "string"},
    "inherited_from_select_005_settlement": {"const": false},
    "invalid_loader_exclusion": {"type": "object"},
    "question": {"const": "non-inferiority plus compute efficiency"},
    "schema": {"const": "hyperlex.select_006_preregistration.v1"},
    "scientific_variable": {"const": "train_schedule"},
    "sealed": {"const": true},
    "select_005_citation": {"type": "object"},
    "shared_settings": {"type": "object"},
    "state": {"const": "PREREGISTERED"},
    "telemetry": {"type": "object"},
    "training_launch_authorized": {"const": false},
    "training_started": {"const": false},
    "vocabulary_expansion": {"type": "object"},
    "warm_start_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
