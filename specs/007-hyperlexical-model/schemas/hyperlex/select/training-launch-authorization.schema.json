{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperlex.local/schemas/hyperlex.training_launch_authorization.v1",
  "title": "SELECT-005 training launch authorization",
  "description": "Operator authorization of compute after TRAINING_READY. Sealing this record does not start training. Schema creation does not authorize SELECT-005.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_receipt_sha256",
    "best_changed",
    "environment_sha256",
    "epochs",
    "executes_training",
    "experiment_id",
    "gradient_steps",
    "next_legal_transition",
    "operator_decision",
    "optimizer_constructed",
    "preregistration_sha256",
    "ready_to_train",
    "reserve_manifest_sha256",
    "schedule",
    "schema",
    "scientific_variable",
    "state",
    "threshold_authorization_sha256",
    "training_launch_authorized",
    "training_started",
    "transition",
    "warm_start_sha256",
    "weights_mutated"
  ],
  "properties": {
    "schema": {"const": "hyperlex.training_launch_authorization.v1"},
    "state": {"const": "TRAINING_LAUNCH_AUTHORIZED"},
    "transition": {"const": "SELECT_005_TRAINING_LAUNCH_AUTHORIZATION"},
    "experiment_id": {"const": "HLX-EXP-2026-09-27-SELECT-005"},
    "admission_receipt_sha256": {"const": "874ac309f1a51a677a692705aebd8fd48ae25dbdb5ca4d1e5c08c7870bdef382"},
    "preregistration_sha256": {"const": "c2dcf3b703f50cb8eb80bb6c2c45335071ded3c4ce89cc669e8a869eb3498baf"},
    "threshold_authorization_sha256": {"const": "e0d8d81b6392692784d92542d0cc5aa6ee6756b93c44bab86e2167ef57cfbc55"},
    "reserve_manifest_sha256": {"const": "2567b3e2d1a3b95b8ea4a474d4dda3ccbe2b6d55b016dd999b5eedcacd4b1f79"},
    "environment_sha256": {"const": "ad253140ed539fd664188c472ff95ed42a98a8b6e7cf6389d6188dde8b83206d"},
    "warm_start_sha256": {"const": "96838b9656a84c3fee1773a41fdf2fbbec2f88f3bc948e4acfbe06c194ac5587"},
    "scientific_variable": {"const": "train_schedule"},
    "schedule": {"$ref": "#/$defs/sealed_schedule"},
    "operator_decision": {"const": "AUTHORIZE"},
    "ready_to_train": {
      "const": true,
      "description": "Scientific and admission gates already passed. This flag is not launch authorization."
    },
    "training_launch_authorized": {
      "const": true,
      "description": "True only because operator_decision is AUTHORIZE on this record."
    },
    "training_started": {"const": false},
    "executes_training": {"const": false},
    "optimizer_constructed": {"const": false},
    "epochs": {"const": 0},
    "gradient_steps": {"const": 0},
    "weights_mutated": {"const": false},
    "best_changed": {"const": false},
    "next_legal_transition": {"const": "SELECT_005_TRAINING_LAUNCH"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sealed_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "candidate", "checkpoint_rule", "selection_metric"],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HYPERLEX_EARLY_STOP",
            "HYPERLEX_EARLY_STOP_MIN_EPOCHS",
            "HYPERLEX_EARLY_STOP_PATIENCE",
            "HYPERLEX_TRAIN_EPOCHS"
          ],
          "properties": {
            "HYPERLEX_EARLY_STOP": {"const": "0"},
            "HYPERLEX_EARLY_STOP_MIN_EPOCHS": {"type": "null"},
            "HYPERLEX_EARLY_STOP_PATIENCE": {"type": "null"},
            "HYPERLEX_TRAIN_EPOCHS": {"const": "40"}
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "HYPERLEX_EARLY_STOP",
            "HYPERLEX_EARLY_STOP_MIN_EPOCHS",
            "HYPERLEX_EARLY_STOP_PATIENCE",
            "HYPERLEX_TRAIN_EPOCHS"
          ],
          "properties": {
            "HYPERLEX_EARLY_STOP": {"const": "1"},
            "HYPERLEX_EARLY_STOP_MIN_EPOCHS": {"const": "4"},
            "HYPERLEX_EARLY_STOP_PATIENCE": {"const": "4"},
            "HYPERLEX_TRAIN_EPOCHS": {"const": "12"}
          }
        },
        "checkpoint_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["restore_best", "strict_increase", "ties"],
          "properties": {
            "restore_best": {"const": true},
            "strict_increase": {"const": true},
            "ties": {"const": "keep_earlier"}
          }
        },
        "selection_metric": {"const": "classify_macro_f1_nonnone"}
      }
    }
  }
}
