{
  "title": "Representation family freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_size",
    "composition_function",
    "device_class",
    "dtype",
    "feature_definition_sha256",
    "model_artifact_sha256",
    "model_name",
    "model_revision",
    "random_seed",
    "template_sha256",
    "threading",
    "tokenizer_sha256"
  ],
  "properties": {
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "composition_function": {
      "enum": [
        "normalized_mean_v1",
        "weighted_mean_by_constituent_token_span",
        "pairwise_relation_summary"
      ]
    },
    "device_class": {
      "type": "string",
      "minLength": 1
    },
    "dtype": {
      "type": "string",
      "minLength": 1
    },
    "feature_definition_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "model_artifact_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "model_name": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "random_seed": {
      "type": "integer"
    },
    "template_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "threading": {
      "type": "string",
      "minLength": 1
    },
    "tokenizer_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperlex.local/schemas/hyperlex/semantic-evidence-v2/representation-freeze.schema.json"
}
